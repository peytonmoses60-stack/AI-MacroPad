{
  "name": "agent-pad",
  "version": "0.1.0",
  "description": "A virtual desk pad that lights up from live AI agent session events.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js --open",
    "selftest": "node src/selftest.js",
    "install-hooks": "node src/install-hooks.js",
    "uninstall-hooks": "node src/install-hooks.js --uninstall",
    "show-hooks": "node src/install-hooks.js --print",
    "test": "node --test"
  }
}
